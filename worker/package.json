{
  "name": "@mailflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @mailflow/api",
    "dev": "dotenv -e ../.env -- tsx watch src/main.ts",
    "prebuild": "npm run build --workspace @mailflow/api",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace @mailflow/api",
    "pretest:delivery": "npm run build --workspace @mailflow/shared && npm run build --workspace @mailflow/api",
    "test:delivery": "dotenv -e ../.env -- tsx --test test/delivery.integration.test.ts",
    "pretest:rate-limits": "npm run build --workspace @mailflow/shared && npm run build --workspace @mailflow/api",
    "test:rate-limits": "dotenv -e ../.env -- tsx --test test/rate-limit.integration.test.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mailflow/api": "^0.1.0",
    "@mailflow/shared": "0.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^10.0.0",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.21",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
