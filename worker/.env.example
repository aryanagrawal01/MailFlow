# The canonical infrastructure values live in the repository root .env.example.
# Copy the root example to .env before running this workspace's dev command.
# Set ELASTICSEARCH_API_KEY in the root .env only when using secured Elasticsearch.
LOG_LEVEL=info
WORKER_CONCURRENCY=10
DELIVERY_MAX_ATTEMPTS=3
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Configure real Ethereal SMTP credentials in the root .env file.
# ETHEREAL_HOST=smtp.ethereal.email
# ETHEREAL_PORT=587
# ETHEREAL_USER=
# ETHEREAL_PASSWORD=
# ETHEREAL_FROM=
# Slack alert credentials and encryption key belong in the ignored root .env; see root .env.example for names.
