# Copy to .env.production on the deployment host. Keep that file out of Git.
# Replace example domains and generate unique random secrets. Prefer a secrets
# manager to persist and inject secret values on the deployment host.
NODE_ENV=production
LOG_LEVEL=info
API_PORT=4000

# Public HTTPS DNS names. Point both names at the HTTPS ingress before startup.
APP_DOMAIN=mailflow.example.com
API_DOMAIN=api.mailflow.example.com
FRONTEND_ORIGIN=https://mailflow.example.com
VITE_API_BASE_URL=https://api.mailflow.example.com
# Firebase web app configuration (public client values; no service account key).
FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Use URL-safe random passwords (base64url is suitable) and use the same values
# in the database/Redis URLs below. Do not reuse local development passwords.
POSTGRES_DB=mailflow
POSTGRES_USER=mailflow
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
DATABASE_URL=postgresql://mailflow:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@postgres:5432/mailflow?schema=public
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@redis:6379

# Keep Elasticsearch private. This Compose deployment uses its private bridge
# network without auth; use a managed secured cluster and API key when required.
ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTICSEARCH_API_KEY=INJECT_FROM_SECRET_MANAGER
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Firebase handles Google's provider redirect at its configured authDomain.
# No Google OAuth client secret or Firebase service-account key is needed here.
SESSION_COOKIE_NAME=mailflow_session
SESSION_TTL_HOURS=168

# Register the Slack callback URL in the Slack app's OAuth settings.
SLACK_CLIENT_ID=REPLACE_WITH_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=INJECT_FROM_SECRET_MANAGER
SLACK_REDIRECT_URI=https://api.mailflow.example.com/api/slack/oauth/callback
SLACK_OAUTH_STATE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SLACK_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64URL_32_BYTE_KEY

# Ethereal is for safe demo/test mail, not production customer delivery.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=INJECT_FROM_SECRET_MANAGER
ETHEREAL_PASSWORD=INJECT_FROM_SECRET_MANAGER
ETHEREAL_FROM=MailFlow Demo <INJECT_ETHEREAL_USER>

WORKER_CONCURRENCY=10
DELIVERY_MAX_ATTEMPTS=3
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RECIPIENTS_PER_CAMPAIGN=10000
