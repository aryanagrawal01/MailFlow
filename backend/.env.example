# The canonical infrastructure values live in the repository root .env.example.
# Set ELASTICSEARCH_API_KEY in the root .env only when using secured Elasticsearch.
# Copy the root example to .env before running this workspace's dev command.
API_PORT=4000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
# Backend uses the Firebase Admin SDK only to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Slack OAuth variable names are documented in the root .env.example; keep real values in root .env.
SESSION_COOKIE_NAME=mailflow_session
SESSION_TTL_HOURS=168
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RECIPIENTS_PER_CAMPAIGN=10000
WORKER_CONCURRENCY=10
DELIVERY_MAX_ATTEMPTS=3
