# Local development values only. Replace passwords before any shared deployment.
POSTGRES_DB=mailflow
POSTGRES_USER=mailflow
POSTGRES_PASSWORD=mailflow_local_only
POSTGRES_PORT=5432

DATABASE_URL=postgresql://mailflow:mailflow_local_only@localhost:5432/mailflow
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
ELASTICSEARCH_URL=http://localhost:9200
# Optional for secured/hosted Elasticsearch; local Compose security is disabled.
# ELASTICSEARCH_API_KEY=
ELASTICSEARCH_PORT=9200

API_PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# Firebase Google Sign-In. Enable Google at Firebase Console > Authentication > Sign-in method.
FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
# Slack OAuth (create a Slack app and register the exact redirect URL below).
# Keep credential values only in your ignored root .env file.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
# SLACK_OAUTH_STATE_SECRET=
# Generate the encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SLACK_TOKEN_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=mailflow_session
SESSION_TTL_HOURS=168
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RECIPIENTS_PER_CAMPAIGN=10000
WORKER_CONCURRENCY=10
DELIVERY_MAX_ATTEMPTS=3

# Ethereal SMTP (create an account at https://ethereal.email/ and paste its credentials).
# ETHEREAL_HOST=smtp.ethereal.email
# ETHEREAL_PORT=587
# ETHEREAL_USER=
# ETHEREAL_PASSWORD=
# ETHEREAL_FROM=

# Elasticsearch development heap. Increase if Docker has sufficient memory.
ES_JAVA_OPTS=-Xms512m -Xmx512m
